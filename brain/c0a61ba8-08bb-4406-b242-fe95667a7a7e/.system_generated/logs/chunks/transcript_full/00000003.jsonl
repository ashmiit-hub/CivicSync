 box-shadow: var(--shadow-sm);\n      position: relative;\n    }\n    .ticket-row-card:hover {\n      box-shadow: var(--shadow-md);\n      transform: translateY(-2px);\n      border-color: var(--primary-border);\n    }\n    .ticket-row-card.active {\n      border-color: var(--primary);\n      box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.2);\n    }\n\n    /* DYNAMIC SCORE BADGE */\n    .score-box {\n      width: 64px;\n      height: 64px;\n      border-radius: var(--radius-md);\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      color: white;\n      font-weight: 800;\n      flex-shrink: 0;\n      box-shadow: var(--shadow-sm);\n    }\n    .score-box .num { font-size: 1.5rem; line-height: 1; }\n    .score-box .lbl { font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.05em; margin-top: 2px; }\n    .score-box.critical { background: linear-gradient(135deg, #EF4444 0%, #B91C1C 100%); }\n    .score-box.high { background: linear-gradient(135deg, #F97316 0%, #C2410C 100%); }\n    .score-box.medium { background: linear-gradient(135deg, #F59E0B 0%, #B45309 100%); }\n    .score-box.low { background: linear-gradient(135deg, #10B981 0%, #047857 100%); }\n\n    /* TICKET CONTENT BLOCKS */\n    .ticket-main {\n      flex: 1;\n      display: flex;\n      flex-direction: column;\n      gap: 6px;\n    }\n    .ticket-title-line {\n      display: flex;\n      align-items: center;\n      gap: 12px;\n    }\n    .ticket-id {\n      font-family: 'JetBrains Mono', monospace;\n      font-size: 0.8rem;\n      font-weight: 600;\n      color: var(--slate-500);\n      background: var(--slate-100);\n      padding: 2px 6px;\n      border-radius: 4px;\n    }\n    .ticket-hazard-type {\n      font-size: 1.05rem;\n      font-weight: 700;\n      color: var(--slate-900);\n      text-transform: capitalize;\n    }\n    .status-badge {\n      font-size: 0.72rem;\n      font-weight: 700;\n      padding: 3px 10px;\n      border-radius: var(--radius-full);\n      text-transform: uppercase;\n      letter-spacing: 0.04em;\n    }\n    .status-badge.reported { background: #FEF3C7; color: #92400E; }\n    .status-badge.verified { background: #DBEAFE; color: #1E40AF; }\n    .status-badge.assigned { background: #E0E7FF; color: #3730A3; }\n    .status-badge.resolved { background: #DCFCE7; color: #166534; }\n    .status-badge.rejected { background: #FEE2E2; color: #991B1B; }\n\n    .ticket-explanation {\n      font-size: 0.88rem;\n      color: var(--slate-600);\n      display: flex;\n      align-items: center;\n      gap: 6px;\n    }\n    .ticket-meta-row {\n      display: flex;\n      align-items: center;\n      gap: 20px;\n      font-size: 0.78rem;\n      color: var(--slate-500);\n      margin-top: 2px;\n    }\n    .meta-tag {\n      display: flex;\n      align-items: center;\n      gap: 6px;\n    }\n\n    /* RIGHT SLA INDICATOR */\n    .ticket-sla-box {\n      text-align: right;\n      display: flex;\n      flex-direction: column;\n      align-items: flex-end;\n      gap: 6px;\n      min-width: 140px;\n    }\n    .sla-countdown {\n      font-size: 0.85rem;\n      font-weight: 700;\n      display: flex;\n      align-items: center;\n      gap: 6px;\n    }\n    .sla-countdown.green { color: var(--low); }\n    .sla-countdown.amber { color: var(--medium); }\n    .sla-countdown.red { color: var(--critical); }\n    .sla-bar-bg {\n      width: 120px;\n      height: 6px;\n      background: var(--slate-200);\n      border-radius: var(--radius-full);\n      overflow: hidden;\n    }\n    .sla-bar-fill {\n      height: 100%;\n      border-radius: var(--radius-full);\n    }\n    .sla-bar-fill.green { width: 35%; background: var(--low); }\n    .sla-bar-fill.amber { width: 75%; background: var(--medium); }\n    .sla-bar-fill.red { width: 100%; background: var(--critical); }\n\n    /* SLIDE-OVER DETAIL DRAWER */\n    .detail-drawer {\n      width: 480px;\n      background: white;\n      border-left: 1px solid var(--slate-200);\n      display: flex;\n      flex-direction: column;\n      overflow-y: auto;\n      flex-shrink: 0;\n      box-shadow: -4px 0 15px rgba(0, 0, 0, 0.05);\n    }\n    .drawer-header {\n      padding: 20px 24px;\n      border-bottom: 1px solid var(--slate-200);\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      position: sticky;\n      top: 0;\n      background: white;\n      z-index: 10;\n    }\n    .drawer-title { font-size: 1.15rem; font-weight: 800; color: var(--slate-900); }\n    .drawer-body {\n      padding: 24px;\n      display: flex;\n      flex-direction: column;\n      gap: 20px;\n    }\n    .photo-preview-card {\n      width: 100%;\n      height: 220px;\n      border-radius: var(--radius-lg);\n      overflow: hidden;\n      position: relative;\n      background: var(--slate-800);\n    }\n    .photo-preview-card img {\n      width: 100%;\n      height: 100%;\n      object-fit: cover;\n    }\n    .privacy-shield-tag {\n      position: absolute;\n      top: 12px;\n      right: 12px;\n      background: rgba(15, 23, 42, 0.85);\n      backdrop-filter: blur(4px);\n      color: #4ADE80;\n      padding: 5px 12px;\n      border-radius: var(--radius-full);\n      font-size: 0.72rem;\n      font-weight: 700;\n      display: flex;\n      align-items: center;\n      gap: 6px;\n      border: 1px solid rgba(74, 222, 128, 0.3);\n    }\n    \n    .formula-breakdown-card {\n      background: var(--slate-50);\n      border: 1px solid var(--slate-200);\n      border-radius: var(--radius-lg);\n      padding: 16px;\n    }\n    .formula-title {\n      font-size: 0.8rem;\n      font-weight: 700;\n      text-transform: uppercase;\n      color: var(--slate-500);\n      margin-bottom: 10px;\n    }\n    .formula-grid {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: 10px;\n      font-size: 0.82rem;\n    }\n    .formula-cell {\n      display: flex;\n      justify-content: space-between;\n      padding: 6px 10px;\n      background: white;\n      border-radius: var(--radius-sm);\n      border: 1px solid var(--slate-200);\n    }\n    .formula-cell .val { font-weight: 700; color: var(--slate-900); }\n\n    .action-panel-card {\n      background: var(--primary-light);\n      border: 1px solid var(--primary-border);\n      border-radius: var(--radius-lg);\n      padding: 18px;\n      display: flex;\n      flex-direction: column;\n      gap: 12px;\n    }\n    .action-panel-title {\n      font-size: 0.85rem;\n      font-weight: 700;\n      color: var(--primary-dark);\n    }\n    .btn-group-grid {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: 10px;\n    }\n    .btn-solid-primary {\n      background: var(--primary);\n      color: white;\n      border: none;\n      padding: 10px 16px;\n      border-radius: var(--radius-md);\n      font-weight: 700;\n      font-size: 0.85rem;\n      cursor: pointer;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      gap: 8px;\n      transition: all 0.15s;\n    }\n    .btn-solid-primary:hover { background: var(--primary-dark); }\n    .btn-solid-success {\n      background: var(--low);\n      color: white;\n      border: none;\n      padding: 10px 16px;\n      border-radius: var(--radius-md);\n      font-weight: 700;\n      font-size: 0.85rem;\n      cursor: pointer;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      gap: 8px;\n    }\n    .btn-solid-danger {\n      background: white;\n      color: var(--critical);\n      border: 1px solid var(--critical-border);\n      padding: 10px 16px;\n      border-radius: var(--radius-md);\n      font-weight: 700;\n      font-size: 0.85rem;\n      cursor: pointer;\n    }\n\n    /* ===================================================\n       2. FULL-SCREEN GIS DENSITY MAP VIEW\n       =================================================== */\n    .map-view-container {\n      width: 100%;\n      height: 100%;\n      position: relative;\n    }\n    #gis-full-map {\n      width: 100%;\n      height: 100%;\n    }\n    .map-floating-panel {\n      position: absolute;\n      top: 20px;\n      left: 20px;\n      background: white;\n      border-radius: var(--radius-lg);\n      padding: 16px 20px;\n      box-shadow: var(--shadow-xl);\n      border: 1px solid var(--slate-200);\n      z-index: 1000;\n      max-width: 320px;\n    }\n    .map-floating-panel h3 { font-size: 0.95rem; font-weight: 800; color: var(--slate-900); }\n    .map-floating-panel p { font-size: 0.78rem; color: var(--slate-500); margin-top: 4px; }\n    .map-legend { margin-top: 12px; display: flex; flex-direction: column; gap: 6px; font-size: 0.75rem; }\n    .legend-row { display: flex; align-items: center; gap: 8px; }\n    .legend-box { width: 14px; height: 14px; border-radius: 3px; }\n\n    /* ===================================================\n       3. DUPLICATE RESOLUTION HUB\n       =================================================== */\n    .duplicate-hub {\n      padding: 28px;\n      overflow-y: auto;\n      max-width: 1100px;\n      margin: 0 auto;\n      width: 100%;\n    }\n    .hub-header { margin-bottom: 24px; }\n    .hub-header h2 { font-size: 1.4rem; font-weight: 800; color: var(--slate-900); }\n    .hub-header p { font-size: 0.85rem; color: var(--slate-500); margin-top: 4px; }\n    .dup-card {\n      background: white;\n      border: 1px solid var(--slate-200);\n      border-radius: var(--radius-lg);\n      padding: 24px;\n      box-shadow: var(--shadow-md);\n      margin-bottom: 24px;\n    }\n    .dup-comparison-grid {\n      display: grid;\n      grid-template-columns: 1fr auto 1fr;\n      gap: 20px;\n      align-items: center;\n      margin: 20px 0;\n    }\n    .dup-side-box {\n      background: var(--slate-50);\n      border: 1px solid var(--slate-200);\n      border-radius: var(--radius-md);\n      padding: 16px;\n      display: flex;\n      flex-direction: column;\n      gap: 10px;\n    }\n    .dup-side-box img {\n      width: 100%;\n      height: 160px;\n      object-fit: cover;\n      border-radius: var(--radius-sm);\n    }\n    .dup-vs-divider {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      gap: 8px;\n    }\n    .distance-pill {\n      background: #FEF3C7;\n      color: #B45309;\n      font-weight: 800;\n      font-size: 0.85rem;\n      padding: 6px 14px;\n      border-radius: var(--radius-full);\n      border: 1px solid #FDE68A;\n    }\n\n    /* ===================================================\n       4. SLA & ESCALATION MONITOR\n       =================================================== */\n    .sla-view-container {\n      padding: 28px;\n      overflow-y: auto;\n      max-width: 1200px;\n      margin: 0 auto;\n      width: 100%;\n    }\n    .sla-table-card {\n      background: white;\n      border: 1px solid var(--slate-200);\n      border-radius: var(--radius-lg);\n      overflow: hidden;\n      box-shadow: var(--shadow-sm);\n      margin-top: 20px;\n    }\n    .data-table {\n      width: 100%;\n      border-collapse: collapse;\n      text-align: left;\n      font-size: 0.85rem;\n    }\n    .data-table th {\n      background: var(--slate-50);\n      padding: 14px 20px;\n      color: var(--slate-500);\n      font-weight: 700;\n      text-transform: uppercase;\n      font-size: 0.72rem;\n      letter-spacing: 0.05em;\n      border-bottom: 1px solid var(--slate-200);\n    }\n    .data-table td {\n      padding: 16px 20px;\n      border-bottom: 1px solid var(--slate-100);\n      color: var(--slate-800);\n    }\n    .data-table tr:hover { background: var(--slate-50); }\n\n    /* ===================================================\n       5. EXECUTIVE ANALYTICS\n       =================================================== */\n    .analytics-view {\n      padding: 28px;\n      overflow-y: auto;\n      max-width: 1200px;\n      margin: 0 auto;\n      width: 100%;\n    }\n    .charts-grid {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: 24px;\n      margin-top: 20px;\n    }\n    .chart-card {\n      background: white;\n      border: 1px solid var(--slate-200);\n      border-radius: var(--radius-lg);\n      padding: 24px;\n      box-shadow: var(--shadow-sm);\n    }\n    .chart-card h3 { font-size: 1rem; font-weight: 700; margin-bottom: 16px; }\n\n    /* MODAL */\n    .modal-backdrop {\n      position: fixed;\n      inset: 0;\n      background: rgba(15, 23, 42, 0.6);\n      backdrop-filter: blur(4px);\n      display: none;\n      align-items: center;\n      justify-content: center;\n      z-index: 2000;\n    }\n    .modal-backdrop.open { display: flex; }\n    .modal-window {\n      background: white;\n      border-radius: var(--radius-lg);\n      width: 500px;\n      max-width: 90%;\n      padding: 28px;\n      box-shadow: var(--shadow-xl);\n    }\n  </style>\n</head>\n<body>\n\n  <!-- TOP APP HEADER -->\n  <header class=\"app-header\">\n    <div class=\"header-left\">\n      <div class=\"brand-container\">\n        <div class=\"brand-icon\">🚦</div>\n        <div>\n          <div class=\"brand-name\">CivicSync</div>\n          <div class=\"brand-subtitle\">Municipal Operations Suite</div>\n        </div>\n      </div>\n\n      <div class=\"live-pulse\">\n        <span class=\"pulse-dot\"></span>\n        <span>Agra & Jodhpur Live Stream</span>\n      </div>\n\n      <!-- Navigation Tabs -->\n      <nav class=\"nav-tabs\">\n        <button class=\"nav-tab-btn active\" onclick=\"switchNavTab('triage')\">\n          <span>📋 Triage Queue</span>\n          <span class=\"tab-counter\" id=\"badge-queue-count\">14</span>\n        </button>\n        <button class=\"nav-tab-btn\" onclick=\"switchNavTab('map')\">\n          <span>🗺️ GIS Density Map</span>\n        </button>\n        <button class=\"nav-tab-btn\" onclick=\"switchNavTab('duplicates')\">\n          <span>⚠️ Duplicate Hub</span>\n          <span class=\"tab-counter\" style=\"background:#FEF3C7; color:#B45309;\">2</span>\n        </button>\n        <button class=\"nav-tab-btn\" onclick=\"switchNavTab('sla')\">\n          <span>⏱️ SLA Escalations</span>\n          <span class=\"tab-counter\" style=\"background:#FEE2E2; color:#B91C1C;\">1</span>\n        </button>\n        <button class=\"nav-tab-btn\" onclick=\"switchNavTab('analytics')\">\n          <span>📊 City Analytics</span>\n        </button>\n      </nav>\n    </div>\n\n    <!-- Header Right Controls -->\n    <div class=\"header-right\">\n      <div class=\"city-picker\">\n        <span>📍 City:</span>\n        <select id=\"header-city-filter\" onchange=\"handleCityFilterChange()\">\n          <option value=\"all\">All Pilot Cities</option>\n          <option value=\"Agra\" selected>Agra (UP)</option>\n          <option value=\"Jodhpur\">Jodhpur (RJ)</option>\n        </select>\n      </div>\n\n      <div class=\"role-pill\">\n        <div class=\"avatar\" id=\"user-avatar\">K</div>\n        <div class=\"role-info\">\n          <div class=\"user-name\" id=\"user-display-name\">Kavita (Ward Officer)</div>\n          <select class=\"role-select-native\" id=\"role-select\" onchange=\"handleRoleSwitch()\">\n            <option value=\"ward_officer\">Ward Officer (AGR-W01 Tajganj)</option>\n            <option value=\"crew_lead\">Deepak (Crew Lead)</option>\n            <option value=\"zonal_engineer\">Zonal Engineer (Agra North)</option>\n            <option value=\"city_admin\">Mr. Sharma (City Admin)</option>\n          </select>\n        </div>\n      </div>\n    </div>\n  </header>\n\n  <!-- MAIN APPLICATION BODY -->\n  <main class=\"app-main\">\n\n    <!-- ========================================================\n         VIEW 1: TRIAGE QUEUE & DRAWER\n         ======================================================== -->\n    <div class=\"view-panel active\" id=\"view-triage\">\n      <div class=\"triage-container\">\n        \n        <!-- Left Filter Sidebar -->\n        <aside class=\"triage-sidebar\">\n          <div>\n            <div class=\"sidebar-section-title\">Status Workflow</div>\n            <div class=\"filter-list\">\n              <button class=\"filter-item active\" onclick=\"setStatusFilter('all')\">\n                <span>All Active Tickets</span>\n                <span class=\"count\">14</span>\n              </button>\n              <button class=\"filter-item\" onclick=\"setStatusFilter('reported')\">\n                <span>Reported (Verify Needed)</span>\n                <span class=\"count\">6</span>\n              </button>\n              <button class=\"filter-item\" onclick=\"setStatusFilter('verified')\">\n                <span>Verified (Ready for Crew)</span>\n                <span class=\"count\">4</span>\n              </button>\n              <button class=\"filter-item\" onclick=\"setStatusFilter('assigned')\">\n                <span>Assigned (In Progress)</span>\n                <span class=\"count\">3</span>\n              </button>\n              <button class=\"filter-item\" onclick=\"setStatusFilter('resolved')\">\n                <span>Resolved (Verified Fixed)</span>\n                <span class=\"count\">1</span>\n              </button>\n            </div>\n          </div>\n\n          <div>\n            <div class=\"sidebar-section-title\">Filter by Ward</div>\n            <div class=\"filter-list\">\n              <button class=\"filter-item active\" onclick=\"setWardFilter('all')\">\n                <span>All Municipal Wards</span>\n                <span class=\"count\">14</span>\n              </button>\n              <button class=\"filter-item\" onclick=\"setWardFilter('AGR-W01')\">\n                <span>Tajganj (AGR-W01)</span>\n                <span class=\"count\">8</span>\n              </button>\n              <button class=\"filter-item\" onclick=\"setWardFilter('AGR-W02')\">\n                <span>Sanjay Place (AGR-W02)</span>\n                <span class=\"count\">3</span>\n              </button>\n              <button class=\"filter-item\" onclick=\"setWardFilter('JDH-W01')\">\n                <span>Ratanada (JDH-W01)</span>\n                <span class=\"count\">3</span>\n              </button>\n            </div>\n          </div>\n\n          <div>\n            <div class=\"sidebar-section-title\">Hazard Categories</div>\n            <div class=\"filter-list\">\n              <button class=\"filter-item\" onclick=\"setClassFilter('pothole')\">\n                <span>Potholes</span>\n                <span class=\"count\">8</span>\n              </button>\n              <button class=\"filter-item\" onclick=\"setClassFilter('open_drain')\">\n                <span>Open Drains / Manholes</span>\n                <span class=\"count\">2</span>\n              </button>\n              <button class=\"filter-item\" onclick=\"setClassFilter('waterlogging')\">\n                <span>Waterlogging</span>\n                <span class=\"count\">2</span>\n              </button>\n              <button class=\"filter-item\" onclick=\"setClassFilter('broken_road')\">\n                <span>Broken Surfaces</span>\n                <span class=\"count\">2</span>\n              </button>\n            </div>\n          </div>\n        </aside>\n\n        <!-- Center Queue Workspace -->\n        <div class=\"queue-workspace\">\n          \n          <!-- KPI Metrics Row -->\n          <div class=\"kpi-row\">\n            <div class=\"kpi-card critical\">\n              <div class=\"kpi-header\">\n                <span class=\"kpi-label\">Critical Dispatch</span>\n                <span style=\"font-size:1.2rem;\">🚨</span>\n              </div>\n              <div class=\"kpi-value\" id=\"kpi-critical\">3</div>\n              <div class=\"kpi-trend\">Score &ge; 75 · 4h SLA Target</div>\n            </div>\n\n            <div class=\"kpi-card high\">\n              <div class=\"kpi-header\">\n                <span class=\"kpi-label\">High Priority</span>\n                <span style=\"font-size:1.2rem;\">⚠️</span>\n              </div>\n              <div class=\"kpi-value\" id=\"kpi-high\">5</div>\n              <div class=\"kpi-trend\">Score 55–74 · 1d SLA Target</div>\n            </div>\n\n            <div class=\"kpi-card\">\n              <div class=\"kpi-header\">\n                <span class=\"kpi-label\">Corroborated Reports</span>\n                <span style=\"font-size:1.2rem;\">👥</span>\n              </div>\n              <div class=\"kpi-value\">9</div>\n              <div class=\"kpi-trend positive\">&plus;3pts Corroboration Bonus</div>\n            </div>\n\n            <div class=\"kpi-card sla\">\n              <div class=\"kpi-header\">\n                <span class=\"kpi-label\">SLA Overdue (L1)</span>\n                <span style=\"font-size:1.2rem;\">⏱️</span>\n              </div>\n              <div class=\"kpi-value\" style=\"color:#9333EA;\">1</div>\n              <div class=\"kpi-trend\" style=\"color:#DC2626;\">Escalated to Zonal Lead</div>\n            </div>\n          </div>\n\n          <!-- Fast Lane Ribbon -->\n          <div class=\"fast-lane-strip\">\n            <div class=\"fast-lane-text\">\n              <div class=\"fast-lane-badge\">⚡ FAST LANE</div>\n              <div>\n                <strong>High-Confidence Automated Triage</strong> · Model Conf &ge; 85%, GPS &le; 20m, Zero Quality Flags\n              </div>\n            </div>\n            <button class=\"fast-lane-btn\" onclick=\"executeFastLaneBatch()\">\n              <span>✓ 1-Click Batch Verify (2)</span>\n            </button>\n          </div>\n\n          <!-- Queue Search & Toolbar -->\n          <div class=\"queue-toolbar\">\n            <div class=\"search-input-wrapper\">\n              <span class=\"search-icon\">🔍</span>\n              <input type=\"text\" class=\"search-input\" id=\"search-box\" placeholder=\"Search ticket ID, road name, or landmark...\" oninput=\"handleSearch()\">\n            </div>\n            <div class=\"toolbar-actions\">\n              <button class=\"btn-outline\" onclick=\"exportQueueCSV()\">\n                <span>📥 Export CSV</span>\n              </button>\n            </div>\n          </div>\n\n          <!-- Scrollable Ticket List -->\n          <div class=\"tickets-scroll-area\" id=\"ticket-list-container\">\n            <!-- Dynamically populated -->\n          </div>\n\n        </div>\n\n        <!-- Slide-Over Inspection Drawer -->\n        <aside class=\"detail-drawer\" id=\"detail-drawer\">\n          <div class=\"drawer-header\">\n            <div>\n              <div class=\"drawer-title\" id=\"drawer-ticket-id\">TK-101</div>\n              <div style=\"font-size:0.75rem; color:var(--slate-500);\" id=\"drawer-timestamp\">Captured 45 mins ago</div>\n            </div>\n            <span class=\"status-badge reported\" id=\"drawer-status-pill\">Reported</span>\n          </div>\n\n          <div class=\"drawer-body\">\n            <!-- Photo Preview with Privacy Shield -->\n            <div class=\"photo-preview-card\">\n              <img id=\"drawer-photo\" src=\"\" alt=\"Hazard Image\">\n              <div class=\"privacy-shield-tag\">\n                <span>🛡️ Faces & Plates Blurred (On-Device)</span>\n              </div>\n            </div>\n\n            <!-- Deterministic Formula Breakdown Card -->\n            <div class=\"formula-breakdown-card\">\n              <div class=\"formula-title\">Explainable Priority Formula (RULES.pdf §1)</div>\n              <div class=\"formula-grid\">\n                <div class=\"formula-cell\">\n                  <span>Class Weight (C):</span>\n                  <span class=\"val\" id=\"drawer-c\">0.80</span>\n                </div>\n                <div class=\"formula-cell\">\n                  <span>Extent Factor (E):</span>\n                  <span class=\"val\" id=\"drawer-e\">1.00</span>\n                </div>\n                <div class=\"formula-cell\">\n                  <span>Model Conf (K):</span>\n                  <span class=\"val\" id=\"drawer-k\">0.92</span>\n                </div>\n                <div class=\"formula-cell\">\n                  <span>Spatial Context (L):</span>\n                  <span class=\"val\" id=\"drawer-l\">1.00 (Hospital)</span>\n                </div>\n                <div class=\"formula-cell\" style=\"grid-column: span 2;\">\n                  <span>Corroboration Bonus (B):</span>\n                  <span class=\"val\" id=\"drawer-b\">&plus;6 (3 reporters)</span>\n                </div>\n              </div>\n              <div style=\"margin-top:10px; font-size:0.85rem; font-weight:700; color:var(--primary-dark);\" id=\"drawer-why-text\">\n                \"Critical priority: large pothole within 200m of District Hospital, reported by 3 people.\"\n              </div>\n            </div>\n\n            <!-- Action Transition Center -->\n            <div class=\"action-panel-card\">\n              <div class=\"action-panel-title\">Municipal Action & Workflow Transition</div>\n              <div class=\"btn-group-grid\" id=\"drawer-action-buttons\">\n                <!-- Dynamically updated based on state & role -->\n              </div>\n            </div>\n\n            <!-- Corroboration & Audit Timeline -->\n            <div>\n              <div style=\"font-size:0.85rem; font-weight:700; color:var(--slate-700); margin-bottom:10px;\">Citizen Corroboration & Audit Trail</div>\n              <div id=\"drawer-timeline\" style=\"display:flex; flex-direction:column; gap:12px;\"></div>\n            </div>\n          </div>\n        </aside>\n\n      </div>\n    </div>\n\n    <!-- ========================================================\n         VIEW 2: FULL-SCREEN GIS DENSITY MAP\n         ======================================================== -->\n    <div class=\"view-panel\" id=\"view-map\">\n      <div class=\"map-view-container\">\n        <div id=\"gis-full-map\"></div>\n        <div class=\"map-floating-panel\">\n          <h3>Deprecation-Proof Density Grid</h3>\n          <p>ST_SnapToGrid (250m cells) replaces deprecated JS heatmap layer. Grouped directly in PostGIS.</p>\n          <div class=\"map-legend\">\n            <div class=\"legend-row\">\n              <div class=\"legend-box\" style=\"background:#EF4444;\"></div>\n              <span>Critical Density Cell (Score &ge; 75)</span>\n            </div>\n            <div class=\"legend-row\">\n              <div class=\"legend-box\" style=\"background:#F97316;\"></div>\n              <span>High Density Cell (Score 55–74)</span>\n            </div>\n            <div class=\"legend-row\">\n              <div class=\"legend-box\" style=\"background:#10B981;\"></div>\n              <span>Medium / Low Density Cell</span>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- ========================================================\n         VIEW 3: DUPLICATE RESOLUTION HUB\n         ======================================================== -->\n    <div class=\"view-panel\" id=\"view-duplicates\">\n      <div class=\"duplicate-hub\">\n        <div class=\"hub-header\">\n          <h2>Duplicate Review Workbench (RULES.pdf §6)</h2>\n          <p>Reports arriving within 25m–50m of existing hazards require officer review to confirm whether they represent the same defect.</p>\n        </div>\n\n        <div class=\"dup-card\" id=\"dup-card-1\">\n          <div style=\"display:flex; justify-content:space-between; align-items:center;\">\n            <div>\n              <span class=\"status-badge\" style=\"background:#FEF3C7; color:#B45309;\">Candidate Pair #DC-801</span>\n              <strong style=\"margin-left:10px; font-size:1.1rem;\">Mahatma Gandhi Road, Agra</strong>\n            </div>\n            <span class=\"distance-pill\">📍 34.2m Distance Delta</span>\n          </div>\n\n          <div class=\"dup-comparison-grid\">\n            <div class=\"dup-side-box\">\n              <div style=\"font-weight:700; color:var(--primary);\">Existing Master Ticket #TK-101</div>\n              <img src=\"https://images.unsplash.com/photo-1515162816999-a0c47dc192f7?w=600&auto=format&fit=crop&q=60\" alt=\"Ticket 1\">\n              <div style=\"font-size:0.8rem;\">\n                <div><strong>Class:</strong> Pothole (Large)</div>\n                <div><strong>Reporters:</strong> 2 distinct commuters</div>\n                <div><strong>Current Score:</strong> 87 (Critical)</div>\n              </div>\n            </div>\n\n            <div class=\"dup-vs-divider\">\n              <div style=\"font-size:1.5rem; color:var(--slate-400);\">⇄</div>\n              <div style=\"font-size:0.75rem; text-align:center; color:var(--slate-500);\">Compatibility Group:<br><strong>Surface Damage</strong></div>\n            </div>\n\n            <div class=\"dup-side-box\">\n              <div style=\"font-weight:700; color:var(--primary);\">New Incoming Submission #TK-109</div>\n              <img src=\"https://images.unsplash.com/photo-1578985545062-69928b1d9587?w=600&auto=format&fit=crop&q=60\" alt=\"Ticket 2\">\n              <div style=\"font-size:0.8rem;\">\n                <div><strong>Class:</strong> Pothole (Medium)</div>\n                <div><strong>Reporter:</strong> Anonymous Citizen</div>\n                <div><strong>GPS Accuracy:</strong> &plusmn;12m</div>\n              </div>\n            </div>\n          </div>\n\n          <div style=\"display:flex; justify-content:flex-end; gap:12px; margin-top:16px;\">\n            <button class=\"btn-outline\" onclick=\"resolveDuplicate('split', 'dup-card-1')\">Keep Separate (Different Holes)</button>\n            <button class=\"btn-solid-primary\" onclick=\"resolveDuplicate('merge', 'dup-card-1')\">✓ Confirm Merge (+3 Corroboration Bonus)</button>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <!-- ========================================================\n         VIEW 4: SLA ESCALATION MONITOR\n         ======================================================== -->\n    <div class=\"view-panel\" id=\"view-sla\">\n      <div class=\"sla-view-container\">\n        <div class=\"hub-header\">\n          <h2>SLA & Working Hours Escalation Center</h2>\n          <p>Enforcing municipal deadlines (Monday–Saturday, 10:00–17:00 IST). Escalates L1 $\\rightarrow$ L2 $\\rightarrow$ L3 automatically.</p>\n        </div>\n\n        <div class=\"sla-table-card\">\n          <table class=\"data-table\">\n            <thead>\n              <tr>\n                <th>Ticket ID</th>\n                <th>Hazard & Location</th>\n                <th>Priority Band</th>\n                <th>Current Stage</th>\n                <th>SLA Target</th>\n                <th>Elapsed Time</th>\n                <th>Escalation Level</th>\n                <th>Action</th>\n              </tr>\n            </thead>\n            <tbody>\n              <tr>\n                <td><span class=\"ticket-id\">TK-103</span></td>\n                <td><strong>Waterlogging</strong><br><span style=\"font-size:0.75rem; color:var(--slate-500);\">Sanjay Place Artery</span></td>\n                <td><span class=\"status-badge\" style=\"background:#FFF7ED; color:#EA580C;\">High (62)</span></td>\n                <td>Assigned to Crew</td>\n                <td>49 working hours</td>\n                <td style=\"color:#DC2626; font-weight:700;\">120% Elapsed</td>\n                <td><span class=\"status-badge\" style=\"background:#FEE2E2; color:#B91C1C;\">Level 1 (Overdue)</span></td>\n                <td><button class=\"btn-outline\" style=\"height:32px; font-size:0.75rem;\" onclick=\"notifyCrewEscalation('TK-103')\">🚨 Ping Crew Lead</button></td>\n              </tr>\n              <tr>\n                <td><span class=\"ticket-id\">TK-101</span></td>\n                <td><strong>Pothole (Large)</strong><br><span style=\"font-size:0.75rem; color:var(--slate-500);\">MG Road near Hospital</span></td>\n                <td><span class=\"status-badge\" style=\"background:#FEF2F2; color:#DC2626;\">Critical (90)</span></td>\n                <td>Verification</td>\n                <td>4 working hours</td>\n                <td style=\"color:#16A34A; font-weight:700;\">45% Elapsed (1h 45m left)</td>\n                <td><span class=\"status-badge\" style=\"background:#DCFCE7; color:#166534;\">Nominal</span></td>\n                <td><button class=\"btn-solid-primary\" style=\"padding:4px 12px; font-size:0.75rem;\" onclick=\"selectTicket('TK-101')\">Review</button></td>\n              </tr>\n            </tbody>\n          </table>\n        </div>\n      </div>\n    </div>\n\n    <!-- ========================================================\n         VIEW 5: EXECUTIVE ANALYTICS\n         ======================================================== -->\n    <div class=\"view-panel\" id=\"view-analytics\">\n      <div class=\"analytics-view\">\n        <div class=\"hub-header\" style=\"display:flex; justify-content:space-between; align-items:center;\">\n          <div>\n            <h2>City Executive Analytics</h2>\n            <p>Aggregated telemetry for municipal resource allocation and contractor audits.</p>\n          </div>\n          <button class=\"btn-solid-primary\" onclick=\"exportQueueCSV()\">📥 Download Full Pilot Dataset (CSV)</button>\n        </div>\n\n        <div class=\"charts-grid\">\n          <div class=\"chart-card\">\n            <h3>Hazard Class Distribution</h3>\n            <canvas id=\"chart-class-distribution\" height=\"220\"></canvas>\n          </div>\n          <div class=\"chart-card\">\n            <h3>Weekly Resolution Velocity</h3>\n            <canvas id=\"chart-resolution-velocity\" height=\"220\"></canvas>\n          </div>\n        </div>\n      </div>\n    </div>\n\n  </main>\n\n  <script>\n    // Rich Master Pilot Dataset\n    let tickets = [\n      {\n        id: \"TK-101\",\n        city: \"Agra\",\n        class: \"pothole\",\n        extent: \"large\",\n        score: 90,\n        band: \"critical\",\n        ward: \"AGR-W01\",\n        location: \"MG Road near District Hospital\",\n        lat: 27.1852,\n        lng: 78.0053,\n        reporters: 3,\n        status: \"reported\",\n        fastLane: true,\n        cVal: 0.80,\n        eVal: 1.00,\n        kVal: 0.92,\n        lVal: \"1.00 (Hospital 200m)\",\n        bVal: 6,\n        whyRank: \"Critical priority: large pothole within 200m of District Hospital, reported by 3 people.\",\n        photoUrl: \"https://images.unsplash.com/photo-1515162816999-a0c47dc192f7?w=600&auto=format&fit=crop&q=60\",\n        slaCountdown: \"1h 45m remaining\",\n        slaState: \"green\",\n        slaPercent: 45,\n        timeline: [\n          { time: \"Today 18:20\", text: \"Reported by Imran (Commuter) with photo\" },\n          { time: \"Today 18:45\", text: \"Corroborated by 2 additional citizen submissions\" }\n        ]\n      },\n      {\n        id: \"TK-102\",\n        city: \"Agra\",\n        class: \"open_drain\",\n        extent: \"medium\",\n        score: 82,\n        band: \"critical\",\n        ward: \"AGR-W01\",\n        location: \"Tajganj Market East Approach\",\n        lat: 27.1720,\n        lng: 78.0420,\n        reporters: 1,\n        status: \"verified\",\n        fastLane: false,\n        cVal: 1.00,\n        eVal: 0.60,\n        kVal: 0.88,\n        lVal: \"0.70 (Market 200m)\",\n        bVal: 0,\n        whyRank: \"Critical priority: open drain hazard near high-footfall Tajganj market.\",\n        photoUrl: \"https://images.unsplash.com/photo-1544620347-c4fd4a3d5957?w=600&auto=format&fit=crop&q=60\",\n        slaCountdown: \"5h 15m remaining\",\n        slaState: \"green\",\n        slaPercent: 25,\n        timeline: [\n          { time: \"Yesterday 14:10\", text: \"Reported by Meena\" },\n          { time: \"Today 10:30\", text: \"Verified by Ward Officer Kavita\" }\n        ]\n      },\n      {\n        id: \"TK-103\",\n        city: \"Agra\",\n        class: \"waterlogging\",\n        extent: \"medium\",\n        score: 62,\n        band: \"high\",\n        ward: \"AGR-W02\",\n        location: \"Sanjay Place Main Commercial Artery\",\n        lat: 27.2010,\n        lng: 78.0050,\n        reporters: 4,\n        status: \"assigned\",\n        fastLane: false,\n        cVal: 0.50,\n        eVal: 0.60,\n        kVal: 0.78,\n        lVal: \"0.90 (Primary Road 30m)\",\n        bVal: 9,\n        whyRank: \"High priority: medium waterlogging reported by 4 distinct citizens.\",\n        photoUrl: \"https://images.unsplash.com/photo-1516214104703-d870798883c5?w=600&auto=format&fit=crop&q=60\",\n        slaCountdown: \"SLA EXCEEDED (120%)\",\n        slaState: \"red\",\n        slaPercent: 100,\n        timeline: [\n          { time: \"26 Oct 09:00\", text: \"Reported by citizen\" },\n          { time: \"27 Oct 11:00\", text: \"Verified and assigned to Deepak (Crew Lead)\" }\n        ]\n      },\n      {\n        id: \"TK-104\",\n        city: \"Jodhpur\",\n        class: \"broken_road\",\n        extent: \"small\",\n        score: 42,\n        band: \"medium\",\n        ward: \"JDH-W01\",\n        location: \"Ratanada Residential Lane 4\",\n        lat: 26.2750,\n        lng: 73.0250,\n        reporters: 1,\n        status: \"reported\",\n        fastLane: false,\n        cVal: 0.60,\n        eVal: 0.30,\n        kVal: 0.65,\n        lVal: \"0.40 (Residential)\",\n        bVal: 0,\n        whyRank: \"Medium priority: small broken road surface in residential lane.\",\n        photoUrl: \"https://images.unsplash.com/photo-1578985545062-69928b1d9587?w=600&auto=format&fit=crop&q=60\",\n        slaCountdown: \"11h remaining\",\n        slaState: \"green\",\n        slaPercent: 20,\n        timeline: [\n          { time: \"Today 11:15\", text: \"Submitted by citizen\" }\n        ]\n      }\n    ];\n\n    let activeNavTab = \"triage\";\n    let selectedTicketId = \"TK-101\";\n    let filterStatus = \"all\";\n    let filterWard = \"all\";\n    let filterClass = \"all\";\n    let filterCity = \"all\";\n    let currentRole = \"ward_officer\";\n\n    // Navigation Switcher\n    function switchNavTab(tabName) {\n      activeNavTab = tabName;\n      document.querySelectorAll('.nav-tab-btn').forEach(btn => btn.classList.remove('active'));\n      event.currentTarget.classList.add('active');\n\n      document.querySelectorAll('.view-panel').forEach(p => p.classList.remove('active'));\n      document.getElementById(`view-${tabName}`).classList.add('active');\n\n      if (tabName === 'map') {\n        setTimeout(initOrResizeMap, 100);\n      } else if (tabName === 'analytics') {\n        setTimeout(initAnalyticsCharts, 100);\n      }\n    }\n\n    // Render Triage Queue\n    function renderQueue() {\n      const container = document.getElementById(\"ticket-list-container\");\n      container.innerHTML = \"\";\n\n      const filtered = tickets.filter(t => {\n        if (filterCity !== \"all\" && t.city !== filterCity) return false;\n        if (filterStatus !== \"all\" && t.status !== filterStatus) return false;\n        if (filterWard !== \"all\" && t.ward !== filterWard) return false;\n        if (filterClass !== \"all\" && t.class !== filterClass) return false;\n        return true;\n      });\n\n      document.getElementById(\"badge-queue-count\").innerText = filtered.length;\n\n      filtered.forEach(t => {\n        const card = document.createElement(\"div\");\n        card.className = `ticket-row-card ${t.id === selectedTicketId ? 'active' : ''}`;\n        card.onclick = () => selectTicket(t.id);\n\n        card.innerHTML = `\n          <div class=\"score-box ${t.band}\">\n            <span class=\"num\">${t.score}</span>\n            <span class=\"lbl\">${t.band}</span>\n          </div>\n\n          <div class=\"ticket-main\">\n            <div class=\"ticket-title-line\">\n              <span class=\"ticket-id\">${t.id}</span>\n              <span class=\"ticket-hazard-type\">${t.class.replace('_', ' ')} (${t.extent})</span>\n              <span class=\"status-badge ${t.status}\">${t.status}</span>\n              ${t.fastLane ? '<span style=\"font-size:0.75rem; color:#2563EB; font-weight:700;\">⚡ Fast Lane</span>' : ''}\n            </div>\n            <div class=\"ticket-explanation\">💡 ${t.whyRank}</div>\n            <div class=\"ticket-meta-row\">\n              <span class=\"meta-tag\">📍 ${t.location} · <strong>${t.ward}</strong></span>\n              <span class=\"meta-tag\">👥 ${t.reporters} distinct citizen report${t.reporters > 1 ? 's' : ''}</span>\n            </div>\n          </div>\n\n          <div class=\"ticket-sla-box\">\n            <div class=\"sla-countdown ${t.slaState}\">⏱️ ${t.slaCountdown}</div>\n            <div class=\"sla-bar-bg\">\n              <div class=\"sla-bar-fill ${t.slaState}\" style=\"width: ${t.slaPercent}%;\"></div>\n            </div>\n          </div>\n        `;\n        container.appendChild(card);\n      });\n\n      renderDrawer();\n    }\n\n    // Select and inspect ticket in Drawer\n    function selectTicket(id) {\n      selectedTicketId = id;\n      renderQueue();\n    }\n\n    function renderDrawer() {\n      const t = tickets.find(i => i.id === selectedTicketId);\n      if (!t) return;\n\n      document.getElementById(\"drawer-ticket-id\").innerText = `${t.id} · ${t.class.replace('_', ' ').toUpperCase()}`;\n      document.getElementById(\"drawer-photo\").src = t.photoUrl;\n      const statusPill = document.getElementById(\"drawer-status-pill\");\n      statusPill.innerText = t.status.toUpperCase();\n      statusPill.className = `status-badge ${t.status}`;\n\n      document.getElementById(\"drawer-c\").innerText = t.cVal;\n      document.getElementById(\"drawer-e\").innerText = t.eVal;\n      document.getElementById(\"drawer-k\").innerText = t.kVal;\n      document.getElementById(\"drawer-l\").innerText = t.lVal;\n      document.getElementById(\"drawer-b\").innerText = `+${t.bVal} (${t.reporters} reports)`;\n      document.getElementById(\"drawer-why-text\").innerText = `\"${t.whyRank}\"`;\n\n      // Build Action Buttons\n      const actionContainer = document.getElementById(\"drawer-action-buttons\");\n      actionContainer.innerHTML = \"\";\n\n      if (t.status === 'reported') {\n        actionContainer.innerHTML = `\n          <button class=\"btn-solid-primary\" onclick=\"transitionTicket('${t.id}', 'verified')\">✓ Verify Ticket</button>\n          <button class=\"btn-solid-danger\" onclick=\"promptReject('${t.id}')\">✕ Reject</button>\n        `;\n      } else if (t.status === 'verified') {\n        actionContainer.innerHTML = `\n          <button class=\"btn-solid-primary\" onclick=\"transitionTicket('${t.id}', 'assigned')\">👷 Assign to Crew</button>\n          <button class=\"btn-solid-danger\" onclick=\"promptReject('${t.id}')\">✕ Reject</button>\n        `;\n      } else if (t.status === 'assigned') {\n        actionContainer.innerHTML = `\n          <button class=\"btn-solid-success\" onclick=\"promptResolve('${t.id}')\">📸 Resolve (Attach After-Photo)</button>\n          <button class=\"btn-outline\" onclick=\"transitionTicket('${t.id}', 'verified')\">Unassign</button>\n        `;\n      } else {\n        actionContainer.innerHTML = `\n          <div style=\"grid-column: span 2; font-size:0.85rem; color:#166534; font-weight:700;\">\n            ✓ Ticket Resolved & Closed. After-photo verified.\n          </div>\n        `;\n      }\n\n      // Render timeline\n      const timelineEl = document.getElementById(\"drawer-timeline\");\n      timelineEl.innerHTML = t.timeline.map(item => `\n        <div style=\"display:flex; gap:10px; font-size:0.82rem;\">\n          <div style=\"width:8px; height:8px; border-radius:50%; background:var(--primary); margin-top:5px;\"></div>\n          <div>\n            <div style=\"color:var(--slate-800);\">${item.text}</div>\n            <div style=\"color:var(--slate-400); font-size:0.72rem;\">${item.time}</div>\n          </div>\n        </div>\n      `).join('');\n    }\n\n    // Ticket State Machine Transitions\n    function transitionTicket(id, newStatus) {\n      const t = tickets.find(i => i.id === id);\n      if (t) {\n        t.status = newStatus;\n        t.timeline.unshift({ time: \"Just now\", text: `Status updated to ${newStatus.toUpperCase()} by ${currentRole}` });\n        renderQueue();\n      }\n    }\n\n    function promptResolve(id) {\n      const photo = prompt(\"Attach after-photo URL (Required before resolving):\", \"storage/repairs/after_repair_fixed.webp\");\n      if (photo) {\n        const t = tickets.find(i => i.id === id);\n        t.status = 'resolved';\n        t.timeline.unshift({ time: \"Just now\", text: `Resolved by Deepak (Crew Lead) with verified after-photo: ${photo}` });\n        alert(`Success: Ticket ${id} resolved! Citizen will receive a push notification.`);\n        renderQueue();\n      }\n    }\n\n    function promptReject(id) {\n      const reason = prompt(\"Select rejection reason:\\n1. not_a_road_hazard\\n2. unclear_photo\\n3. outside_area\\n4. duplicate_merged\", \"not_a_road_hazard\");\n      if (reason) {\n        const t = tickets.find(i => i.id === id);\n        t.status = 'rejected';\n        t.timeline.unshift({ time: \"Just now\", text: `Ticket rejected: ${reason}` });\n        renderQueue();\n      }\n    }\n\n    function executeFastLaneBatch() {\n      const pendingFast = tickets.filter(t => t.fastLane && t.status === 'reported');\n      if (pendingFast.length === 0) {\n        alert(\"No pending Fast Lane tickets in current queue.\");\n        return;\n      }\n      pendingFast.forEach(t => {\n        t.status = 'verified';\n        t.timeline.unshift({ time: \"Just now\", text: \"Verified via 1-Click Fast Lane batch action\" });\n      });\n      alert(`Verified ${pendingFast.length} high-confidence tickets instantly!`);\n      renderQueue();\n    }\n\n    function resolveDuplicate(action, cardId) {\n      document.getElementById(cardId).style.opacity = \"0.5\";\n      setTimeout(() => {\n        document.getElementById(cardId).remove();\n        alert(action === 'merge' ? \"Reports merged! +3 corroboration bonus added to master ticket.\" : \"Marked as independent distinct hazards.\");\n      }, 300);\n    }\n\n    function setStatusFilter(status) {\n      filterStatus = status;\n      document.querySelectorAll('.triage-sidebar .filter-list:nth-of-type(1) .filter-item').forEach(b => b.classList.remove('active'));\n      event.currentTarget.classList.add('active');\n      renderQueue();\n    }\n\n    function setWardFilter(ward) {\n      filterWard = ward;\n      document.querySelectorAll('.triage-sidebar .filter-list:nth-of-type(2) .filter-item').forEach(b => b.classList.remove('active'));\n      event.currentTarget.classList.add('active');\n      renderQueue();\n    }\n\n    function setClassFilter(cls) {\n      filterClass = (filterClass === cls) ? 'all' : cls;\n      renderQueue();\n    }\n\n    function handleCityFilterChange() {\n      filterCity = document.getElementById(\"header-city-filter\").value;\n      renderQueue();\n    }\n\n    function handleRoleSwitch() {\n      currentRole = document.getElementById(\"role-select\").value;\n      const displayNames = {\n        'ward_officer': 'Kavita (Ward Officer)',\n        'crew_lead': 'Deepak (Crew Lead)',\n        'zonal_engineer': 'Zonal Lead (North)',\n        'city_admin': 'Mr. Sharma (City Admin)'\n      };\n      document.getElementById(\"user-display-name\").innerText = displayNames[currentRole];\n      document.getElementById(\"user-avatar\").innerText = displayNames[currentRole][0];\n      renderDrawer();\n    }\n\n    function handleSearch() {\n      const q = document.getElementById(\"search-box\").value.toLowerCase();\n      const cards = document.querySelectorAll(\".ticket-row-card\");\n      cards.forEach(c => {\n        const text = c.innerText.toLowerCase();\n        c.style.display = text.includes(q) ? \"flex\" : \"none\";\n      });\n    }\n\n    function exportQueueCSV() {\n      let csv = \"TicketID,City,Ward,HazardClass,Extent,PriorityScore,PriorityBand,Status,Reporters,Location\\n\";\n      tickets.forEach(t => {\n        csv += `\"${t.id}\",\"${t.city}\",\"${t.ward}\",\"${t.class}\",\"${t.extent}\",${t.score},\"${t.band}\",\"${t.status}\",${t.reporters},\"${t.location}\"\\n`;\n      });\n      const blob = new Blob([csv], { type: \"text/csv\" });\n      const url = URL.createObjectURL(blob);\n      const a = document.createElement(\"a\");\n      a.href = url;\n      a.download = `CivicSync_Tickets_${new Date().toISOString().slice(0,10)}.csv`;\n      a.click();\n    }\n\n    // Leaflet GIS Map Init\n    let leafletMap = null;\n    function initOrResizeMap() {\n      if (!leafletMap) {\n        leafletMap = L.map('gis-full-map').setView([27.1800, 78.0100], 13);\n        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {\n          attribution: '&copy; OpenStreetMap contributors'\n        }).addTo(leafletMap);\n\n        // ST_SnapToGrid simulated 250m density cells\n        const densityCells = [\n          { lat: 27.1852, lng: 78.0053, count: 4, color: \"#EF4444\" },\n          { lat: 27.1720, lng: 78.0420, count: 2, color: \"#F97316\" },\n          { lat: 27.2010, lng: 78.0050, count: 3, color: \"#EF4444\" }\n        ];\n\n        densityCells.forEach(cell => {\n          L.circle([cell.lat, cell.lng], {\n            radius: 200,\n            fillColor: cell.color,\n            color: cell.color,\n            weight: 2,\n            opacity: 0.8,\n            fillOpacity: 0.35\n          }).addTo(leafletMap).bindPopup(`<strong>Density Cell</strong><br>${cell.count} Active Defects`);\n        });\n\n        // Add ticket markers\n        tickets.forEach(t => {\n          L.marker([t.lat, t.lng]).addTo(leafletMap)\n            .bindPopup(`<strong>${t.id}: ${t.class.toUpperCase()}</strong><br>${t.location}<br>Score: ${t.score} (${t.band})`);\n        });\n      } else {\n        leafletMap.invalidateSize();\n      }\n    }\n\n    // Chart.js Analytics Init\n    let chartsInitialized = false;\n    function initAnalyticsCharts() {\n      if (chartsInitialized) return;\n      chartsInitialized = true;\n\n      // Class distribution doughnut\n      new Chart(document.getElementById('chart-class-distribution'), {\n        type: 'doughnut',\n        data: {\n          labels: ['Potholes', 'Open Drains', 'Waterlogging', 'Broken Road'],\n          datasets: [{\n            data: [8, 2, 2, 2],\n            backgroundColor: ['#2563EB', '#DC2626', '#F59E0B', '#10B981']\n          }]\n        },\n        options: { responsive: true, plugins: { legend: { position: 'bottom' } } }\n      });\n\n      // Resolution velocity bar\n      new Chart(document.getElementById('chart-resolution-velocity'), {\n        type: 'bar',\n        data: {\n          labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'],\n          datasets: [\n            { label: 'Reported', data: [12, 19, 14, 18, 15, 8], backgroundColor: '#BFDBFE' },\n            { label: 'Resolved', data: [8, 14, 12, 16, 14, 7], backgroundColor: '#16A34A' }\n          ]\n        },\n        options: { responsive: true, plugins: { legend: { position: 'bottom' } } }\n      });\n    }\n\n    // Start App\n    renderQueue();\n  </script>\n</body>\n</html>\n","Overwrite":true,"Path":"C:\\Users\\ashmi\\.gemini\\antigravity\\scratch\\civicsync\\apps\\dashboard\\index.html"}}]}
