{"step_index":72,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-29T14:44:14Z","input_tokens":1977,"cache_read_tokens":108806,"output_tokens":516,"tool_calls":[{"name":"write_file","args":{"Content":"\"\"\"\nCivicSync ML Pipeline - Dataset Ingestion & Augmentation\nSpecifications: TRD.pdf §6 (TRD-A1 to TRD-A4), TOOLING.pdf §4\n\"\"\"\n\nimport os\nimport cv2\nimport numpy as np\nfrom typing import List, Tuple, Generator\n\nCLASSES = [\n    'pothole',\n    'open_drain',\n    'broken_road',\n    'waterlogging',\n    'none_of_these'\n]\n\nCLASS_TO_IDX = {cls_name: idx for idx, cls_name in enumerate(CLASSES)}\nIDX_TO_CLASS = {idx: cls_name for idx, cls_name in enumerate(CLASSES)}\nINPUT_SHAPE = (224, 224, 3)\n\ndef preprocess_image(image_path: str, target_size: Tuple[int, int] = (224, 224)) -> np.ndarray:\n    \"\"\"Read image, resize to target dimensions, and normalize to [-1, 1] for MobileNetV2.\"\"\"\n    img = cv2.imread(image_path)\n    if img is None:\n        raise ValueError(f\"Failed to load image at {image_path}\")\n    img_rgb = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)\n    resized = cv2.resize(img_rgb, target_size, interpolation=cv2.INTER_AREA)\n    normalized = (resized.astype(np.float32) / 127.5) - 1.0\n    return normalized\n\ndef create_representative_dataset_generator(samples: List[str]) -> Generator[List[np.ndarray], None, None]:\n    \"\"\"Generator for TFLite post-training full INT8 quantization calibration.\"\"\"\n    for sample_path in samples[:150]:\n        try:\n            img = preprocess_image(sample_path)\n            yield [np.expand_dims(img, axis=0)]\n        except Exception:\n            continue\n","Overwrite":true,"Path":"C:\\Users\\ashmi\\.gemini\\antigravity\\scratch\\civicsync\\ml\\dataset.py"}}]}
