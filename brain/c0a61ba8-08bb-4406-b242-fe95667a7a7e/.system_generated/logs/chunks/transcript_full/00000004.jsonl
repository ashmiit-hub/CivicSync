,\n        location: \"Ratanada Residential Lane 4\",\n        lat: 26.2750,\n        lng: 73.0250,\n        reporters: 1,\n        status: \"reported\",\n        fastLane: false,\n        cVal: 0.60,\n        eVal: 0.30,\n        kVal: 0.65,\n        lVal: \"0.40 (Residential)\",\n        bVal: 0,\n        whyRank: \"Medium priority: small broken road surface in residential lane.\",\n        photoUrl: \"https://images.unsplash.com/photo-1578985545062-69928b1d9587?w=600&auto=format&fit=crop&q=60\",\n        slaCountdown: \"11h remaining\",\n        slaState: \"green\",\n        slaPercent: 20,\n        timeline: [\n          { time: \"Today 11:15\", text: \"Submitted by citizen\" }\n        ]\n      }\n    ];\n\n    let activeNavTab = \"triage\";\n    let selectedTicketId = \"TK-101\";\n    let filterStatus = \"all\";\n    let filterWard = \"all\";\n    let filterClass = \"all\";\n    let filterCity = \"all\";\n    let currentRole = \"ward_officer\";\n\n    function switchNavTab(tabName) {\n      activeNavTab = tabName;\n      document.querySelectorAll('.nav-tab-btn').forEach(btn => btn.classList.remove('active'));\n      event.currentTarget.classList.add('active');\n\n      document.querySelectorAll('.view-panel').forEach(p => p.classList.remove('active'));\n      document.getElementById(`view-${tabName}`).classList.add('active');\n\n      if (tabName === 'map') {\n        setTimeout(initOrResizeMap, 100);\n      } else if (tabName === 'analytics') {\n        setTimeout(initAnalyticsCharts, 100);\n      }\n    }\n\n    function renderQueue() {\n      const container = document.getElementById(\"ticket-list-container\");\n      container.innerHTML = \"\";\n\n      const filtered = tickets.filter(t => {\n        if (filterCity !== \"all\" && t.city !== filterCity) return false;\n        if (filterStatus !== \"all\" && t.status !== filterStatus) return false;\n        if (filterWard !== \"all\" && t.ward !== filterWard) return false;\n        if (filterClass !== \"all\" && t.class !== filterClass) return false;\n        return true;\n      });\n\n      document.getElementById(\"badge-queue-count\").innerText = filtered.length;\n\n      filtered.forEach(t => {\n        const card = document.createElement(\"div\");\n        card.className = `ticket-row-card ${t.id === selectedTicketId ? 'active' : ''}`;\n        card.onclick = () => selectTicket(t.id);\n\n        card.innerHTML = `\n          <div class=\"score-box ${t.band}\">\n            <span class=\"num\">${t.score}</span>\n            <span class=\"lbl\">${t.band}</span>\n          </div>\n\n          <div class=\"ticket-main\">\n            <div class=\"ticket-title-line\">\n              <span class=\"ticket-id\">${t.id}</span>\n              <span class=\"ticket-hazard-type\">${t.class.replace('_', ' ')} (${t.extent})</span>\n              <span class=\"status-badge ${t.status}\">${t.status}</span>\n              ${t.fastLane ? '<span style=\"font-size:0.75rem; color:#2563EB; font-weight:700;\">⚡ Fast Lane</span>' : ''}\n            </div>\n            <div class=\"ticket-explanation\">💡 ${t.whyRank}</div>\n            <div class=\"ticket-meta-row\">\n              <span class=\"meta-tag\">📍 ${t.location} · <strong>${t.ward}</strong></span>\n              <span class=\"meta-tag\">👥 ${t.reporters} distinct citizen report${t.reporters > 1 ? 's' : ''}</span>\n            </div>\n          </div>\n\n          <div class=\"ticket-sla-box\">\n            <div class=\"sla-countdown ${t.slaState}\">⏱️ ${t.slaCountdown}</div>\n            <div class=\"sla-bar-bg\">\n              <div class=\"sla-bar-fill ${t.slaState}\" style=\"width: ${t.slaPercent}%;\"></div>\n            </div>\n          </div>\n        `;\n        container.appendChild(card);\n      });\n\n      renderDrawer();\n    }\n\n    function selectTicket(id) {\n      selectedTicketId = id;\n      renderQueue();\n    }\n\n    function renderDrawer() {\n      const t = tickets.find(i => i.id === selectedTicketId);\n      if (!t) return;\n\n      document.getElementById(\"drawer-ticket-id\").innerText = `${t.id} · ${t.class.replace('_', ' ').toUpperCase()}`;\n      document.getElementById(\"drawer-photo\").src = t.photoUrl;\n      const statusPill = document.getElementById(\"drawer-status-pill\");\n      statusPill.innerText = t.status.toUpperCase();\n      statusPill.className = `status-badge ${t.status}`;\n\n      document.getElementById(\"drawer-c\").innerText = t.cVal;\n      document.getElementById(\"drawer-e\").innerText = t.eVal;\n      document.getElementById(\"drawer-k\").innerText = t.kVal;\n      document.getElementById(\"drawer-l\").innerText = t.lVal;\n      document.getElementById(\"drawer-b\").innerText = `+${t.bVal} (${t.reporters} reports)`;\n      document.getElementById(\"drawer-why-text\").innerText = `\"${t.whyRank}\"`;\n\n      const actionContainer = document.getElementById(\"drawer-action-buttons\");\n      actionContainer.innerHTML = \"\";\n\n      if (t.status === 'reported') {\n        actionContainer.innerHTML = `\n          <button class=\"btn-solid-primary\" onclick=\"transitionTicket('${t.id}', 'verified')\">✓ Verify Ticket</button>\n          <button class=\"btn-solid-danger\" onclick=\"promptReject('${t.id}')\">✕ Reject</button>\n        `;\n      } else if (t.status === 'verified') {\n        actionContainer.innerHTML = `\n          <button class=\"btn-solid-primary\" onclick=\"transitionTicket('${t.id}', 'assigned')\">👷 Assign to Crew</button>\n          <button class=\"btn-solid-danger\" onclick=\"promptReject('${t.id}')\">✕ Reject</button>\n        `;\n      } else if (t.status === 'assigned') {\n        actionContainer.innerHTML = `\n          <button class=\"btn-solid-success\" onclick=\"promptResolve('${t.id}')\">📸 Resolve (Attach After-Photo)</button>\n          <button class=\"btn-outline\" onclick=\"transitionTicket('${t.id}', 'verified')\">Unassign</button>\n        `;\n      } else {\n        actionContainer.innerHTML = `\n          <div style=\"grid-column: span 2; font-size:0.85rem; color:#166534; font-weight:700;\">\n            ✓ Ticket Resolved & Closed. After-photo verified.\n          </div>\n        `;\n      }\n\n      const timelineEl = document.getElementById(\"drawer-timeline\");\n      timelineEl.innerHTML = t.timeline.map(item => `\n        <div style=\"display:flex; gap:10px; font-size:0.82rem;\">\n          <div style=\"width:8px; height:8px; border-radius:50%; background:var(--primary); margin-top:5px;\"></div>\n          <div>\n            <div style=\"color:var(--slate-800);\">${item.text}</div>\n            <div style=\"color:var(--slate-400); font-size:0.72rem;\">${item.time}</div>\n          </div>\n        </div>\n      `).join('');\n    }\n\n    function transitionTicket(id, newStatus) {\n      const t = tickets.find(i => i.id === id);\n      if (t) {\n        t.status = newStatus;\n        t.timeline.unshift({ time: \"Just now\", text: `Status updated to ${newStatus.toUpperCase()} by ${currentRole}` });\n        renderQueue();\n      }\n    }\n\n    function promptResolve(id) {\n      const photo = prompt(\"Attach after-photo URL (Required before resolving):\", \"storage/repairs/after_repair_fixed.webp\");\n      if (photo) {\n        const t = tickets.find(i => i.id === id);\n        t.status = 'resolved';\n        t.timeline.unshift({ time: \"Just now\", text: `Resolved by Deepak (Crew Lead) with verified after-photo: ${photo}` });\n        alert(`Success: Ticket ${id} resolved! Citizen will receive a push notification.`);\n        renderQueue();\n      }\n    }\n\n    function promptReject(id) {\n      const reason = prompt(\"Select rejection reason:\\n1. not_a_road_hazard\\n2. unclear_photo\\n3. outside_area\\n4. duplicate_merged\", \"not_a_road_hazard\");\n      if (reason) {\n        const t = tickets.find(i => i.id === id);\n        t.status = 'rejected';\n        t.timeline.unshift({ time: \"Just now\", text: `Ticket rejected: ${reason}` });\n        renderQueue();\n      }\n    }\n\n    function executeFastLaneBatch() {\n      const pendingFast = tickets.filter(t => t.fastLane && t.status === 'reported');\n      if (pendingFast.length === 0) {\n        alert(\"No pending Fast Lane tickets in current queue.\");\n        return;\n      }\n      pendingFast.forEach(t => {\n        t.status = 'verified';\n        t.timeline.unshift({ time: \"Just now\", text: \"Verified via 1-Click Fast Lane batch action\" });\n      });\n      alert(`Verified ${pendingFast.length} high-confidence tickets instantly!`);\n      renderQueue();\n    }\n\n    function resolveDuplicate(action, cardId) {\n      document.getElementById(cardId).style.opacity = \"0.5\";\n      setTimeout(() => {\n        document.getElementById(cardId).remove();\n        alert(action === 'merge' ? \"Reports merged! +3 corroboration bonus added to master ticket.\" : \"Marked as independent distinct hazards.\");\n      }, 300);\n    }\n\n    function setStatusFilter(status) {\n      filterStatus = status;\n      document.querySelectorAll('.triage-sidebar .filter-list:nth-of-type(1) .filter-item').forEach(b => b.classList.remove('active'));\n      event.currentTarget.classList.add('active');\n      renderQueue();\n    }\n\n    function setWardFilter(ward) {\n      filterWard = ward;\n      document.querySelectorAll('.triage-sidebar .filter-list:nth-of-type(2) .filter-item').forEach(b => b.classList.remove('active'));\n      event.currentTarget.classList.add('active');\n      renderQueue();\n    }\n\n    function setClassFilter(cls) {\n      filterClass = (filterClass === cls) ? 'all' : cls;\n      renderQueue();\n    }\n\n    function handleCityFilterChange() {\n      filterCity = document.getElementById(\"header-city-filter\").value;\n      renderQueue();\n    }\n\n    function handleRoleSwitch() {\n      currentRole = document.getElementById(\"role-select\").value;\n      const displayNames = {\n        'ward_officer': 'Kavita (Ward Officer)',\n        'crew_lead': 'Deepak (Crew Lead)',\n        'zonal_engineer': 'Zonal Lead (North)',\n        'city_admin': 'Mr. Sharma (City Admin)'\n      };\n      document.getElementById(\"user-display-name\").innerText = displayNames[currentRole];\n      document.getElementById(\"user-avatar\").innerText = displayNames[currentRole][0];\n      renderDrawer();\n    }\n\n    function handleSearch() {\n      const q = document.getElementById(\"search-box\").value.toLowerCase();\n      const cards = document.querySelectorAll(\".ticket-row-card\");\n      cards.forEach(c => {\n        const text = c.innerText.toLowerCase();\n        c.style.display = text.includes(q) ? \"flex\" : \"none\";\n      });\n    }\n\n    function exportQueueCSV() {\n      let csv = \"TicketID,City,Ward,HazardClass,Extent,PriorityScore,PriorityBand,Status,Reporters,Location\\n\";\n      tickets.forEach(t => {\n        csv += `\"${t.id}\",\"${t.city}\",\"${t.ward}\",\"${t.class}\",\"${t.extent}\",${t.score},\"${t.band}\",\"${t.status}\",${t.reporters},\"${t.location}\"\\n`;\n      });\n      const blob = new Blob([csv], { type: \"text/csv\" });\n      const url = URL.createObjectURL(blob);\n      const a = document.createElement(\"a\");\n      a.href = url;\n      a.download = `CivicSync_Tickets_${new Date().toISOString().slice(0,10)}.csv`;\n      a.click();\n    }\n\n    let leafletMap = null;\n    function initOrResizeMap() {\n      if (!leafletMap) {\n        leafletMap = L.map('gis-full-map').setView([27.1800, 78.0100], 13);\n        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {\n          attribution: '&copy; OpenStreetMap contributors'\n        }).addTo(leafletMap);\n\n        const densityCells = [\n          { lat: 27.1852, lng: 78.0053, count: 4, color: \"#EF4444\" },\n          { lat: 27.1720, lng: 78.0420, count: 2, color: \"#F97316\" },\n          { lat: 27.2010, lng: 78.0050, count: 3, color: \"#EF4444\" }\n        ];\n\n        densityCells.forEach(cell => {\n          L.circle([cell.lat, cell.lng], {\n            radius: 200,\n            fillColor: cell.color,\n            color: cell.color,\n            weight: 2,\n            opacity: 0.8,\n            fillOpacity: 0.35\n          }).addTo(leafletMap).bindPopup(`<strong>Density Cell</strong><br>${cell.count} Active Defects`);\n        });\n\n        tickets.forEach(t => {\n          L.marker([t.lat, t.lng]).addTo(leafletMap)\n            .bindPopup(`<strong>${t.id}: ${t.class.toUpperCase()}</strong><br>${t.location}<br>Score: ${t.score} (${t.band})`);\n        });\n      } else {\n        leafletMap.invalidateSize();\n      }\n    }\n\n    let chartsInitialized = false;\n    function initAnalyticsCharts() {\n      if (chartsInitialized) return;\n      chartsInitialized = true;\n\n      new Chart(document.getElementById('chart-class-distribution'), {\n        type: 'doughnut',\n        data: {\n          labels: ['Potholes', 'Open Drains', 'Waterlogging', 'Broken Road'],\n          datasets: [{\n            data: [8, 2, 2, 2],\n            backgroundColor: ['#2563EB', '#DC2626', '#F59E0B', '#10B981']\n          }]\n        },\n        options: { responsive: true, plugins: { legend: { position: 'bottom' } } }\n      });\n\n      new Chart(document.getElementById('chart-resolution-velocity'), {\n        type: 'bar',\n        data: {\n          labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'],\n          datasets: [\n            { label: 'Reported', data: [12, 19, 14, 18, 15, 8], backgroundColor: '#BFDBFE' },\n            { label: 'Resolved', data: [8, 14, 12, 16, 14, 7], backgroundColor: '#16A34A' }\n          ]\n        },\n        options: { responsive: true, plugins: { legend: { position: 'bottom' } } }\n      });\n    }\n\n    renderQueue();\n  </script>\n</body>\n</html>\n","Overwrite":true,"Path":"C:\\Users\\ashmi\\.gemini\\antigravity\\brain\\c0a61ba8-08bb-4406-b242-fe95667a7a7e\\civicsync_dashboard.html"}}]}
