\\n      node[\\\"amenity\\\"=\\\"school\\\"]({bbox_str});\\n      way[\\\"amenity\\\"=\\\"school\\\"]({bbox_str});\\n      \\n      // Primary & Secondary Arterial Roads (L = 0.90 within 30m)\\n      way[\\\"highway\\\"=\\\"primary\\\"]({bbox_str});\\n      way[\\\"highway\\\"=\\\"secondary\\\"]({bbox_str});\\n      \\n      // Transit Hubs & Markets (L = 0.70 within 200m)\\n      node[\\\"amenity\\\"=\\\"bus_station\\\"]({bbox_str});\\n      node[\\\"railway\\\"=\\\"station\\\"]({bbox_str});\\n      node[\\\"amenity\\\"=\\\"marketplace\\\"]({bbox_str});\\n    );\\n    out center;\\n    \\\"\\\"\\\"\\n    return query\\n\\ndef generate_sample_sql(output_path: str = \\\"supabase/migrations/20261029000002_osm_context_features.sql\\\"):\\n    \\\"\\\"\\\"Generate SQL migration file populated with sample real coordinates.\\\"\\\"\\\"\\n    sql_lines = [\\n        \\\"-- CivicSync OSM Ingest:\n<truncated 1650 bytes>","Overwrite":"true","Path":"\"C:\\\\Users\\\\ashmi\\\\.gemini\\\\antigravity\\\\scratch\\\\civicsync\\\\scripts\\\\osm_ingest.py\""}}],"truncated_fields":["tool_calls"]}
