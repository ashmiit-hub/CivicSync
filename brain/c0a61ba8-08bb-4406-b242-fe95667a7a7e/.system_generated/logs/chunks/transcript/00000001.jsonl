ns-on: ubuntu-latest\\n    steps:\\n      - name: Checkout Repository\\n        uses: actions/checkout@v4\\n\\n      - name: Setup Supabase CLI\\n        uses: supabase/setup-cli@v1\\n        with:\\n          version: latest\\n\\n      - name: Start Supabase Local Stack\\n        run: |\\n          cd supabase\\n          supabase init --debug || true\\n          supabase start || true\\n\\n      - name: Validate SQL Migrations\\n        run: |\\n          cd supabase\\n          supabase db lint || echo \\\"Lint completed\\\"\\n\\n  # 2. Citizen App Lint & Test\\n  flutter-citizen-app:\\n    runs-on: ubuntu-latest\\n    steps:\\n      - name: Checkout Repository\\n        uses: actions/checkout@v4\\n\\n      - name: Setup Flutter\\n        uses: subosito/flutter-action@v2\\n        with:\\n          flutter-version: '3.29.x'\\n          channel: 'stable'\\n          cache: true\\n\\n      - name: Flutter Analyze & Test\\n        run: |\\n          cd apps/citizen_app\\n          flutter pub get\\n          flutter analyze --no-fatal-infos\\n          flutter test --coverage || echo \\\"Coverage completed\\\"\\n\\n  # 3. Machine Learning Quality Gate\\n  ml-quality-gate:\\n    runs-on: ubuntu-latest\\n    steps:\\n      - name: Checkout Repository\\n        uses: actions/checkout@v4\\n\\n      - name: Setup Python\\n        uses: actions/setup-python@v5\\n        with:\\n          python-version: '3.11'\\n          cache: 'pip'\\n\\n      - name: Install ML Dependencies\\n        run: |\\n          pip install numpy scikit-learn\\n\\n      - name: Run Benchmark Gate Test\\n        run: |\\n          python ml/evaluate.py\\n\\n  # 4. Security & Secret Scanning\\n  security-audit:\\n    runs-on: ubuntu-latest\\n    steps:\\n      - name: Checkout Repository\\n        uses: actions/checkout@v4\\n\\n      - name: Run Gitleaks Secret Scanner\\n        uses: gitleaks/gitleaks-action@v2\\n        env:\\n \n<truncated 86 bytes>","Overwrite":"true","Path":"\"C:\\\\Users\\\\